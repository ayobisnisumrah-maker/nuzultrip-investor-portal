# =============================================================================
# Nuzultrip Investor Portal — environment template
# =============================================================================
# Copy to `.env.local` and fill in real values. Never commit real credentials.

# Public — exposed to browser bundle
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-your-supabase-anon-key"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-supabase-service-role-key"
SUPABASE_AUTH_HOOK_SECRET="replace-with-a-32-char-random-string"
AUDIT_IP_SALT="replace-with-a-32-byte-random-hex-string"
IDENTITY_HASH_SALT="replace-with-a-32-byte-random-hex-string"

# Email delivery
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="investor-relations@example.com"
EMAIL_FROM_NAME="Nuzultrip Investor Relations"

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_GRAPH_API_VERSION="v23.0"

# Halo Nuzul — server-only OpenAI Responses API
OPENAI_API_KEY=""
HALO_NUZUL_MODEL="gpt-5.6-luna"

# Local tooling only
SUPABASE_PROJECT_REF=""
