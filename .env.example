# =============================================================================
# Nuzultrip Investor Portal — environment template
# =============================================================================
# Copy to `.env.local` and fill in real values.
#
#   cp .env.example .env.local
#
# NEVER commit `.env.local` or any file containing real credentials.
# Values below are obviously-fake placeholders, not truncated real secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# Public — exposed to the browser bundle. MUST NOT contain secrets.
# -----------------------------------------------------------------------------

# Supabase project URL. Local development (supabase start) uses port 54321.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"

# The anon/publishable key. Safe in the browser: it is subject to Row Level
# Security. It is NOT a secret, but it is also NOT an authorisation grant.
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-your-supabase-anon-key"

# Canonical origin of this deployment. Used for auth redirects, emails, sitemap,
# and Open Graph URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# development | staging | production
NEXT_PUBLIC_APP_ENV="development"


# -----------------------------------------------------------------------------
# Server-only — SECRETS. Never prefix any of these with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------

# Bypasses Row Level Security completely. Treat as root credentials.
# Only importable from src/server/admin/** (enforced by ESLint + CI).
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-supabase-service-role-key"

# Shared secret for the Supabase custom access-token hook. Optional locally.
SUPABASE_AUTH_HOOK_SECRET="replace-with-a-32-char-random-string"

# Salt used to hash IP addresses stored in audit_logs and portal_inquiries.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_IP_SALT="replace-with-a-32-byte-random-hex-string"

# Salt used to hash investor identity numbers. Rotating this invalidates all
# existing hashes — see docs/SECURITY.md §9 before changing it.
IDENTITY_HASH_SALT="replace-with-a-32-byte-random-hex-string"


# -----------------------------------------------------------------------------
# Email delivery (optional until Phase 11)
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="investor-relations@example.com"
EMAIL_FROM_NAME="Nuzultrip Investor Relations"


# -----------------------------------------------------------------------------
# Local tooling only — not read by the application
# -----------------------------------------------------------------------------
# Supabase project ref, used by `pnpm db:types` when generating against remote.
SUPABASE_PROJECT_REF=""
