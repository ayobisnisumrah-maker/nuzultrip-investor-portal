'use client'

import { useState, useTransition } from 'react'
import { useRouter } from 'next/navigation'

import {
  archiveOwnershipOffering,
  closeOwnershipOffering,
  pauseOwnershipOffering,
  publishOwnershipOffering,
  resumeOwnershipOffering,
} from '@/server/ownership/offering-actions'

import { Alert } from '@/ui/alert'
import { Button } from '@/ui/button'
import {
  Dialog,
  DialogClose,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
} from '@/ui/dialog'
import { useToast } from '@/ui/toast'

type OwnershipOfferingStatus =
  | 'draft'
  | 'open'
  | 'paused'
  | 'closed'
  | 'archived'

type ActionKey =
  | 'publish'
  | 'pause'
  | 'resume'
  | 'close'
  | 'archive'

type ActionConfig = {
  label: string
  permission: string
  consequence: string
  variant: 'primary' | 'secondary' | 'danger'
}

const CONFIG: Record<ActionKey, ActionConfig> = {
  publish: {
    label: 'Terbitkan Penawaran',
    permission: 'ownership_offerings.publish',
    consequence:
      'Penawaran akan menjadi aktif dan dapat menerima investasi baru sesuai konfigurasi yang berlaku.',
    variant: 'primary',
  },

  pause: {
    label: 'Jeda Penawaran',
    permission: 'ownership_offerings.pause',
    consequence:
      'Penawaran akan dihentikan sementara dan tidak dapat menerima investasi baru sampai dibuka kembali.',
    variant: 'secondary',
  },

  resume: {
    label: 'Buka Kembali',
    permission: 'ownership_offerings.resume',
    consequence:
      'Penawaran akan kembali aktif dan dapat menerima investasi baru.',
    variant: 'primary',
  },

  close: {
    label: 'Tutup Penawaran',
    permission: 'ownership_offerings.close',
    consequence:
      'Penawaran akan ditutup dan tidak dapat menerima investasi baru lagi.',
    variant: 'danger',
  },

  archive: {
    label: 'Arsipkan Penawaran',
    permission: 'ownership_offerings.archive',
    consequence:
      'Penawaran akan dipindahkan ke arsip. Data tetap tersimpan sebagai catatan.',
    variant: 'danger',
  },
}

const HANDLERS = {
  publish: publishOwnershipOffering,
  pause: pauseOwnershipOffering,
  resume: resumeOwnershipOffering,
  close: closeOwnershipOffering,
  archive: archiveOwnershipOffering,
}

function getAction(
  status: OwnershipOfferingStatus,
): ActionKey | null {
  switch (status) {
    case 'draft':
      return 'publish'

    case 'open':
      return 'pause'

    case 'paused':
      return 'resume'

    case 'closed':
      return 'archive'

    default:
      return null
  }
}

function getSecondaryAction(
  status: OwnershipOfferingStatus,
): ActionKey | null {
  if (status === 'open' || status === 'paused') {
    return 'close'
  }

  return null
}

export function OwnershipOfferingActions({
  offeringId,
  name,
  status,
  permissions,
}: {
  offeringId: string
  name: string
  status: OwnershipOfferingStatus
  permissions: readonly string[]
}) {
  const router = useRouter()
  const { push } = useToast()

  const [selected, setSelected] =
    useState<ActionKey | null>(null)

  const [error, setError] =
    useState<string | null>(null)

  const [pending, startTransition] =
    useTransition()

  const primaryKey = getAction(status)
  const secondaryKey = getSecondaryAction(status)

  const availableActions = [
    primaryKey,
    secondaryKey,
  ].filter(
    (key): key is ActionKey =>
      key !== null &&
      permissions.includes(CONFIG[key].permission),
  )

  if (availableActions.length === 0) {
    return null
  }

  const selectedAction = selected
    ? CONFIG[selected]
    : null

  function confirm() {
    if (!selected || pending) {
      return
    }

    setError(null)

    startTransition(async () => {
      try {
        const handler = HANDLERS[selected]

        const result = await handler({
          offeringId,
        })

        if (!result.ok) {
          setError(result.error.message)
          return
        }

        const completedAction = CONFIG[selected]

        setSelected(null)

        push({
          tone: 'success',
          title: 'Status penawaran diperbarui',
          description: `${name} berhasil diproses melalui aksi "${completedAction.label}".`,
        })

        router.refresh()
      } catch (cause) {
        setError(
          cause instanceof Error
            ? cause.message
            : 'Aksi penawaran tidak dapat diselesaikan.',
        )
      }
    })
  }

  return (
    <>
      <div className="flex flex-wrap items-center justify-end gap-2">
        {availableActions.map((key) => {
          const action = CONFIG[key]

          return (
            <Button
              key={key}
              variant={action.variant}
              onClick={() => {
                setError(null)
                setSelected(key)
              }}
            >
              {action.label}
            </Button>
          )
        })}
      </div>

      <Dialog
        open={selected !== null}
        onOpenChange={(open) => {
          if (!open && !pending) {
            setSelected(null)
            setError(null)
          }
        }}
      >
        <DialogContent
          size="sm"
          showClose={!pending}
        >
          {selected && selectedAction ? (
            <>
              <DialogHeader>
                <DialogTitle>
                  {selectedAction.label}?
                </DialogTitle>

                <DialogDescription>
                  Anda akan mengubah lifecycle penawaran{' '}
                  <strong>{name}</strong>.
                </DialogDescription>
              </DialogHeader>

              <div className="rounded-md border border-border bg-sunken p-3 text-body-sm text-fg-muted">
                {selectedAction.consequence}
              </div>

              {error ? (
                <Alert
                  tone="danger"
                  title="Aksi tidak dapat diselesaikan"
                >
                  {error}
                </Alert>
              ) : null}

              <DialogFooter>
                <DialogClose asChild>
                  <Button
                    variant="secondary"
                    disabled={pending}
                  >
                    Batal
                  </Button>
                </DialogClose>

                <Button
                  variant={selectedAction.variant}
                  loading={pending}
                  onClick={confirm}
                >
                  {selectedAction.label}
                </Button>
              </DialogFooter>
            </>
          ) : null}
        </DialogContent>
      </Dialog>
    </>
  )
}
